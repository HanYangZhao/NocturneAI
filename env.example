# OpenAI API Key
OPENAI_API_KEY=
# OpenAI chat model (e.g. gpt-4o, gpt-4o-mini, gpt-4o-realtime-preview)
# ElevenLabs API Key
ELEVENLABS_API_KEY=
# ElevenLabs Voice ID (default voice - can be overridden in voices.json)
# Multiple voices can be configured in src/app/voices.json for simultaneous playback
ELEVENLABS_VOICE_ID=

# Optional: PORT for local testing
PORT=3000
NEXT_PUBLIC_LOG_LEVEL=info
API_PASSWORD_HASH=